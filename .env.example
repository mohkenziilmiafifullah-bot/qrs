APP_NAME="QR Field Sales"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qr_saas
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting umumnya tidak menyediakan Redis — pakai "database" sebagai default aman.
# Ganti ke "redis" kalau nanti pindah ke VPS sendiri yang sudah terpasang Redis.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Wajib jalankan queue worker (php artisan queue:work) agar analytics logger & job lain berjalan.
# Di shared hosting, jadwalkan via cron: * * * * * php artisan schedule:run

DEPOSIT_PROVIDER=DANA
DEPOSIT_NUMBER=0895630447306
DEPOSIT_ACCOUNT_NAME="Nama Pemilik Akun DANA"

# Google OAuth: buat OAuth Client jenis Web Application di Google Cloud Console.
# Authorized redirect URI lokal: http://localhost/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
